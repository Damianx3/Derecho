# DERECHO local configuration
# Copy this file to .env for local development.
#
# Never commit the real .env file.

DERECHO_ENV=development

# Model paths will be added as models are selected.
# WHISPER_MODEL_PATH=
# TRANSLATION_MODEL_PATH=
# LLM_MODEL_PATH=

# USB devices are discovered automatically. Optional shell exports for ambiguous setups:
# export DERECHO_MIC_DEVICE='plughw:CARD=Device,DEV=0'
# export DERECHO_SPEAKER_DEVICE='plughw:CARD=UACDemoV10,DEV=0'
# Optional voice-folder override (shell export; .env is not automatically loaded):
# export DERECHO_VOICE_DIR='/home/damian/Projects/piper-voices'

# Optional performance path. Keep defaults until benchmarked on the Pi.
# export DERECHO_WHISPER_MODEL='/home/damian/Projects/whisper.cpp/models/ggml-base.bin'
# export DERECHO_WHISPER_THREADS=4
# Start whisper-server separately, bound to loopback, before setting this:
# export DERECHO_WHISPER_SERVER='http://127.0.0.1:8080/inference'
# export DERECHO_LIVE_STT=1
# Reuse voices inside the existing Piper virtualenv (CLI fallback on startup failure):
# export DERECHO_PIPER_PERSISTENT=1
# export DERECHO_PIPER_PYTHON='/home/damian/Projects/piper-venv/bin/python'
